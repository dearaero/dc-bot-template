# Developer Portal > Bot > Token. Bu dosyayı .env olarak kopyalayın.
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=
# Geliştirme sunucusu; global dağıtım için gerekli değildir.
DISCORD_GUILD_ID=
NODE_ENV=development
LOG_LEVEL=info
MAX_CONCURRENT_INTERACTIONS=100
HANDLER_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
